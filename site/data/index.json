      "id": "kiley/2026-09-14-analysis-workbook",
      "member": "kiley",
      "folder": "2026-09-14-analysis-workbook",
      "title": "Analysis Workbook",
      "assignment": "Beta Forecast",
      "has_metadata": true,
      "submitted": "2026-09-14",
