      "review": null
    },
    {
      "id": "aanika/2026-09-15-social-media-sentiment-analysis",
      "member": "aanika",
      "folder": "2026-09-15-social-media-sentiment-analysis",
      "title": "Social Media Sentiment Analysis",
      "assignment": "Vader Sentiment Analysis",
      "has_metadata": true,
      "submitted": "2026-09-15",
      "updated": "2026-09-15",
      "dates_from": "git",
      "submitted_by": "Aanika",
      "notes": "",
      "body": "We analyzed 15 Pennsylvania-related Reddit posts and retrieved 282 visible comments from their discussion threads. We organized the posts and comments into 10 common political topics, preserved the verbatim comments with direct Reddit links, and used VADER to classify each comment as positive, negative, or neutral. We then created summary statistics, charts, topic comparisons, political-figure comparisons, and representative quotes to show the main patterns in the discussion. Because the posts focus mainly on statewide Pennsylvania politics rather than PA-7 specifically, the findings provide broader election context rather than a representative picture of PA-7 voters.",
